<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NeuroSky MindWave"
            android:textColor="@color/colorOnPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulator"
            android:textColor="#90CAF9"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── Card 1: Signal Status ─────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/viewDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_signal_dot" />

                    <TextView
                        android:id="@+id/tvQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="GOOD"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/signalGood" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvPoorSignal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Poor Signal: 0"
                        android:textSize="13sp"
                        android:textColor="#888888" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Card 2: eSense ─────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESENSE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#888888"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="14dp" />

                    <!-- Attention -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Attention"
                            android:textSize="13sp"
                            android:textColor="#444444" />

                        <TextView
                            android:id="@+id/tvAttention"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary"
                            android:gravity="end" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressAttention"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/colorPrimary"
                        android:progressBackgroundTint="#E3F2FD"
                        android:layout_marginBottom="16dp" />

                    <!-- Meditation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Meditation"
                            android:textSize="13sp"
                            android:textColor="#444444" />

                        <TextView
                            android:id="@+id/tvMeditation"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/meditationColor"
                            android:gravity="end" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressMeditation"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/meditationColor"
                        android:progressBackgroundTint="#F3E5F5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Card 3: EEG Bands ──────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EEG FREQUENCY BANDS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#888888"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="12dp" />

                    <!-- Delta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="64dp" android:layout_height="wrap_content"
                            android:text="δ  Delta" android:textSize="12sp" android:textColor="#555555" />
                        <ProgressBar android:id="@+id/progressDelta"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                            android:max="100000" android:progress="0"
                            android:progressTint="#3949AB" android:progressBackgroundTint="#E8EAF6"
                            android:layout_marginHorizontal="8dp" />
                        <TextView android:id="@+id/tvDelta"
                            android:layout_width="72dp" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="#666666"
                            android:gravity="end" android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Theta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="64dp" android:layout_height="wrap_content"
                            android:text="θ  Theta" android:textSize="12sp" android:textColor="#555555" />
                        <ProgressBar android:id="@+id/progressTheta"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                            android:max="100000" android:progress="0"
                            android:progressTint="#1E88E5" android:progressBackgroundTint="#E3F2FD"
                            android:layout_marginHorizontal="8dp" />
                        <TextView android:id="@+id/tvTheta"
                            android:layout_width="72dp" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="#666666"
                            android:gravity="end" android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Low Alpha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="64dp" android:layout_height="wrap_content"
                            android:text="α  Lo-α" android:textSize="12sp" android:textColor="#555555" />
                        <ProgressBar android:id="@+id/progressLowAlpha"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                            android:max="100000" android:progress="0"
                            android:progressTint="#00897B" android:progressBackgroundTint="#E0F2F1"
                            android:layout_marginHorizontal="8dp" />
                        <TextView android:id="@+id/tvLowAlpha"
                            android:layout_width="72dp" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="#666666"
                            android:gravity="end" android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- High Alpha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="64dp" android:layout_height="wrap_content"
                            android:text="α  Hi-α" android:textSize="12sp" android:textColor="#555555" />
                        <ProgressBar android:id="@+id/progressHighAlpha"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                            android:max="100000" android:progress="0"
                            android:progressTint="#26A69A" android:progressBackgroundTint="#E0F2F1"
                            android:layout_marginHorizontal="8dp" />
                        <TextView android:id="@+id/tvHighAlpha"
                            android:layout_width="72dp" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="#666666"
                            android:gravity="end" android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Low Beta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="64dp" android:layout_height="wrap_content"
                            android:text="β  Lo-β" android:textSize="12sp" android:textColor="#555555" />
                        <ProgressBar android:id="@+id/progressLowBeta"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                            android:max="100000" android:progress="0"
                            android:progressTint="#F4511E" android:progressBackgroundTint="#FBE9E7"
                            android:layout_marginHorizontal="8dp" />
                        <TextView android:id="@+id/tvLowBeta"
                            android:layout_width="72dp" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="#666666"
                            android:gravity="end" android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- High Beta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="64dp" android:layout_height="wrap_content"
                            android:text="β  Hi-β" android:textSize="12sp" android:textColor="#555555" />
                        <ProgressBar android:id="@+id/progressHighBeta"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                            android:max="100000" android:progress="0"
                            android:progressTint="#E53935" android:progressBackgroundTint="#FFEBEE"
                            android:layout_marginHorizontal="8dp" />
                        <TextView android:id="@+id/tvHighBeta"
                            android:layout_width="72dp" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="#666666"
                            android:gravity="end" android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Low Gamma -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="64dp" android:layout_height="wrap_content"
                            android:text="γ  Lo-γ" android:textSize="12sp" android:textColor="#555555" />
                        <ProgressBar android:id="@+id/progressLowGamma"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                            android:max="100000" android:progress="0"
                            android:progressTint="#8E24AA" android:progressBackgroundTint="#F3E5F5"
                            android:layout_marginHorizontal="8dp" />
                        <TextView android:id="@+id/tvLowGamma"
                            android:layout_width="72dp" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="#666666"
                            android:gravity="end" android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Mid Gamma -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="64dp" android:layout_height="wrap_content"
                            android:text="γ  Mid-γ" android:textSize="12sp" android:textColor="#555555" />
                        <ProgressBar android:id="@+id/progressMidGamma"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                            android:max="100000" android:progress="0"
                            android:progressTint="#AB47BC" android:progressBackgroundTint="#F3E5F5"
                            android:layout_marginHorizontal="8dp" />
                        <TextView android:id="@+id/tvMidGamma"
                            android:layout_width="72dp" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="#666666"
                            android:gravity="end" android:fontFamily="monospace" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Card 4: Simulator Mode ─────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIMULATOR MODE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#888888"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRandom"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="Random"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFocused"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="Focused"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRelaxed"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="Relaxed"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPoorSignal"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="Poor Signal"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Timestamp -->
            <TextView
                android:id="@+id/tvUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
